{
  "name": "executive-suite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "api": "tsx watch --clear-screen=false --exclude ./data --exclude ./data/** server/index.ts",
    "free-ports": "node scripts/free-dev-ports.mjs",
    "dev": "npm run free-ports && concurrently -k -n api,web -c blue,green \"npm run api\" \"vite --port=3000 --host=0.0.0.0\"",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=server/dist/index.cjs --packages=external",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start:dist": "serve dist -s -l 4173",
    "deploy:build": "npm run build",
    "deploy:serve": "npm run build && npm run start:dist",
    "deploy:zip": "npm run build && node scripts/zip-release.mjs",
    "clean": "rm -rf dist",
    "test": "npm run test:integration",
    "test:integration": "tsx --test tests/integration/**/*.test.ts",
    "client:start": "node scripts/start-client.mjs",
    "client:build": "npm run build && npm run build:server",
    "client:deploy": "npm run client:build && npm run client:start",
    "lint": "tsc --noEmit",
    "license:keygen": "tsx scripts/license-keygen.ts",
    "license:generate": "tsx scripts/generate-license.ts",
    "electron:start": "electron .",
    "electron:build": "npm run build && npm run build:server && electron-builder",
    "electron:build:win": "npm run build && npm run build:server && electron-builder --win"
  },
  "build": {
    "appId": "com.executivesuite.app",
    "productName": "Executive Suite",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/dist/**/*",
      "node_modules/sql.js/**/*",
      "package.json"
    ],
    "asar": false,
    "extraResources": [],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    }
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.2",
    "serve": "^14.2.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
